# Credenciales opcionales (copia este archivo a .env y rellena)
# Carga con:  pip install python-dotenv

# NASA Earthdata (https://urs.earthdata.nasa.gov/users/new) — necesario solo para DESCARGAR
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Data Space (https://dataspace.copernicus.eu) — necesario para descargar
CDSE_USERNAME=
CDSE_PASSWORD=

# JAXA G-Portal (https://gportal.jaxa.jp) — necesario para su API
GPORTAL_CLIENT_ID=
GPORTAL_CLIENT_SECRET=

# Supabase (https://supabase.com) — DB de candidatos en la nube
# (ejecutar antes supabase/esquema_rpc.sql en el SQL Editor del panel).
# SUPABASE_URL = URL del proyecto (Settings -> API)
# SUPABASE_KEY = service_role key (sk_...): SOLO en local — salta RLS y
#                puede escribir (la usan poblador_supabase.py y
#                prueba_similitud_nube.py)
SUPABASE_URL=
SUPABASE_KEY=

# Carpeta donde se guardan los datos descargados
NSAC_DATA_DIR=./data

# Poner a 0 si tu red intercepta certificados SSL (no recomendado)
NSAC_VERIFY_SSL=1
